// Prisma provides typed PostgreSQL access and reviewable SQL migrations for a solo-maintained project.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum SourceType {
  hn
  reddit
  github
  rss
}
model Source {
  id         String        @id @default(cuid())
  name       String        @unique
  type       SourceType
  base_url   String
  created_at DateTime      @default(now()) @db.Timestamptz(3)
  documents  RawDocument[]
}
model RawDocument {
  id           String   @id @default(cuid())
  source_id    String
  source       Source   @relation(fields: [source_id], references: [id], onDelete: Restrict)
  external_id  String
  title        String
  url          String
  author       String?
  content      String?
  published_at DateTime @db.Timestamptz(3)
  ingested_at  DateTime @default(now()) @db.Timestamptz(3)
  raw_json     Json
  @@unique([source_id, external_id])
  @@index([ingested_at])
}
