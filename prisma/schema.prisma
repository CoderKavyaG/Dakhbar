// Prisma provides typed PostgreSQL access and reviewable SQL migrations for a solo-maintained project.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  hn
  reddit
  github
  rss
}

enum EntityType {
  company
  product
  technology
  language
  framework
  database
  protocol
  platform
  tool
}

enum StoryStatus {
  active
  review_needed
  confirmed
}

model Source {
  id         String        @id @default(cuid())
  name       String        @unique
  type       SourceType
  base_url   String
  created_at DateTime      @default(now()) @db.Timestamptz(3)
  documents  RawDocument[]
}

model RawDocument {
  id              String                      @id @default(cuid())
  source_id       String
  source          Source                      @relation(fields: [source_id], references: [id], onDelete: Restrict)
  external_id     String
  title           String
  url             String
  author          String?
  content         String?
  og_image_url    String?
  og_description  String?
  published_at    DateTime                    @db.Timestamptz(3)
  ingested_at     DateTime                    @default(now()) @db.Timestamptz(3)
  raw_json        Json
  embedding       Unsupported("vector(384)")?
  story_documents StoryDocument[]

  @@unique([source_id, external_id])
  @@index([ingested_at])
}

model Entity {
  id         String        @id @default(cuid())
  name       String        @unique
  type       EntityType
  aliases    String[]      @default([])
  created_at DateTime      @default(now()) @db.Timestamptz(3)
  stories    StoryEntity[]
  followers  Following[]
}

model Story {
  id                     String          @id @default(cuid())
  title                  String
  status                 StoryStatus     @default(active)
  significance_score     Float           @default(0)
  possibly_related_to_id String?
  possibly_related_to    Story?          @relation("RelatedStories", fields: [possibly_related_to_id], references: [id], onDelete: SetNull)
  related_stories        Story[]         @relation("RelatedStories")
  created_at             DateTime        @default(now()) @db.Timestamptz(3)
  updated_at             DateTime        @updatedAt @db.Timestamptz(3)
  documents              StoryDocument[]
  entities               StoryEntity[]

  @@index([updated_at])
  @@index([significance_score])
}

model StoryDocument {
  story_id         String
  raw_document_id  String
  similarity_score Float
  is_primary       Boolean     @default(false)
  created_at       DateTime    @default(now()) @db.Timestamptz(3)
  story            Story       @relation(fields: [story_id], references: [id], onDelete: Cascade)
  raw_document     RawDocument @relation(fields: [raw_document_id], references: [id], onDelete: Cascade)

  @@id([story_id, raw_document_id])
  @@unique([raw_document_id])
  @@index([story_id])
}

model StoryEntity {
  story_id  String
  entity_id String
  story     Story  @relation(fields: [story_id], references: [id], onDelete: Cascade)
  entity    Entity @relation(fields: [entity_id], references: [id], onDelete: Cascade)

  @@id([story_id, entity_id])
  @@index([entity_id])
}

model User {
  id         String      @id
  created_at DateTime    @default(now()) @db.Timestamptz(3)
  updated_at DateTime    @updatedAt @db.Timestamptz(3)
  following  Following[]
  visit      UserVisit?
}

model Following {
  user_id     String
  entity_id   String
  followed_at DateTime @default(now()) @db.Timestamptz(3)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  entity      Entity   @relation(fields: [entity_id], references: [id], onDelete: Cascade)

  @@id([user_id, entity_id])
  @@index([entity_id])
  @@index([user_id, followed_at])
}

model UserVisit {
  user_id      String   @id
  last_seen_at DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
