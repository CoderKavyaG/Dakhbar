    "postinstall": "prisma generate",
    "seed:entities": "node --env-file=.env --import tsx scripts/seed-entities.ts",
    "cluster": "node --env-file=.env --import tsx scripts/cluster.ts",
    "recluster": "node --env-file=.env --import tsx scripts/recluster.ts",
    "verify:phase2": "node --env-file=.env --import tsx scripts/verify-phase2.ts",
    "billing:setup": "node --env-file=.env --import tsx scripts/setup-stripe.ts",
    "email:test": "node --env-file=.env --import tsx scripts/send-brief-emails.ts",
    "email:preview": "node --env-file=.env --import tsx scripts/send-brief-preview.ts"
